<!-- pages/index/index.wxml -->
<view class="container">

  <!-- ─── 顶部头部 ─── -->
  <view class="header">
    <view class="header-bg"></view>
    <view class="header-content">
      <view class="header-top">
        <view>
          <text class="greeting">{{greeting}}，{{studentName}} 👋</text>
          <text class="date-text">{{todayDate}} {{weekday}}</text>
        </view>
      </view>

      <!-- 7天日期选择（今天在最右） -->
      <view class="date-tabs">
        <view
          class="date-tab {{item.selected ? 'date-tab-active' : ''}} {{item.hasRecord ? 'date-tab-has-record' : ''}}"
          wx:for="{{dateTabs}}"
          wx:key="key"
          bindtap="switchDate"
          data-key="{{item.key}}"
        >
          <text class="date-tab-weekday">{{item.weekday}}</text>
          <view class="date-tab-dot" wx:if="{{item.hasRecord && !item.selected}}"></view>
        </view>
      </view>

      <!-- 进度卡片 -->
      <view class="progress-card">
        <view class="progress-info">
          <view>
            <view class="progress-title-row">
              <text class="progress-title">{{isToday ? '今日完成进度' : todayDate + ' 完成记录'}}</text>
              <button class="share-icon-btn" open-type="share" wx:if="{{isToday}}">
                <view class="share-box-icon">
                  <view class="share-box-arrow"></view>
                  <view class="share-box-rect"></view>
                </view>
              </button>
            </view>
            <text class="progress-sub">{{completedSubTasks}}/{{totalSubTasks}} 个小任务</text>
          </view>
          <text class="progress-percent">{{progress}}%</text>
        </view>
        <view class="progress-bar-bg">
          <view class="progress-bar-fill" style="width: {{progress}}%">
            <view class="progress-shine"></view>
          </view>
        </view>
        <view class="progress-emoji">
          <block wx:if="{{isToday}}">
            <text wx:if="{{progress === 100}}">🏆 全部完成！太棒了！</text>
            <text wx:elif="{{progress >= 80}}">🌟 快完成了，加油！</text>
            <text wx:elif="{{progress >= 50}}">💪 已完成一半，继续！</text>
            <text wx:elif="{{progress > 0}}">🚀 已经开始啦！</text>
            <text wx:else>✨ 点击任务开始今天的学习</text>
          </block>
          <block wx:else>
            <text wx:if="{{progress === 100}}">🏆 当天全部完成！</text>
            <text wx:elif="{{progress > 0}}">📋 当天完成了 {{progress}}%</text>
            <text wx:else>📋 当天没有完成记录</text>
          </block>
        </view>
      </view>
    </view>
  </view>

  <!-- ─── 任务列表 ─── -->
  <view class="task-list">

    <view
      class="task-card"
      wx:for="{{tasks}}"
      wx:key="id"
      wx:for-item="task"
    >
      <!-- 任务头部 -->
      <view class="task-header" style="border-left: 8rpx solid {{task.color}};">
        <view class="task-icon-wrap" style="background: {{task.color}}20;">
          <text class="task-icon">{{task.icon}}</text>
        </view>
        <view class="task-info">
          <text class="task-name">{{task.name}}</text>
          <text class="task-time">⏱ 约 {{task.estimatedTime}} 分钟</text>
        </view>
        <view class="task-actions">
          <view class="task-edit-btn" bindtap="goToDetail" data-task-id="{{task.id}}">
            <text class="task-edit-text">编辑</text>
          </view>
          <view class="task-del-btn" bindtap="deleteTask" data-task-id="{{task.id}}" wx:if="{{isToday}}">
            <text class="task-del-text">🗑</text>
          </view>
        </view>
      </view>

      <!-- 子任务列表 -->
      <view class="subtask-list" wx:if="{{task.subTasks && task.subTasks.length > 0}}">
        <view
          class="subtask-item {{subDoneMap[sub.id] ? 'subtask-done' : ''}}"
          wx:for="{{task.subTasks}}"
          wx:key="id"
          wx:for-item="sub"
          bindtap="toggleSubTask"
          data-task-id="{{task.id}}"
          data-sub-id="{{sub.id}}"
        >
          <view class="subtask-check {{subDoneMap[sub.id] ? 'checked' : ''}}" style="{{subDoneMap[sub.id] ? 'background:' + task.color + '; border-color:' + task.color + ';' : ''}}">
            <text class="check-icon" wx:if="{{subDoneMap[sub.id]}}">✓</text>
          </view>
          <text class="subtask-name">{{sub.name}}</text>
          <text class="subtask-time">{{sub.estimatedTime}}min</text>
        </view>
      </view>

      <!-- 空子任务提示 -->
      <view class="subtask-empty" wx:if="{{!task.subTasks || task.subTasks.length === 0}}">
        <text class="subtask-empty-text">暂无子任务，点击「编辑」添加</text>
      </view>
    </view>

    <!-- 空状态：今天 -->
    <view class="empty-state" wx:if="{{tasks.length === 0 && isToday}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">还没有任务，快去添加吧！</text>
    </view>

    <!-- 空状态：历史日期无记录 -->
    <view class="empty-state" wx:if="{{tasks.length === 0 && !isToday}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">当天没有任务记录</text>
    </view>

    <!-- 添加任务按钮（仅今天显示） -->
    <view class="add-task-btn" bindtap="goToAddTask" wx:if="{{isToday}}">
      <text class="add-icon">＋</text>
      <text class="add-text">添加新任务</text>
    </view>

    <view style="height: 60rpx;"></view>
  </view>

</view>
