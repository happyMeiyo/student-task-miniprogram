<!-- pages/settings/settings.wxml -->
<view class="container">

  <!-- 顶部横幅 -->
  <view class="header">
    <view class="avatar-wrap">
      <text class="avatar-emoji">🎒</text>
    </view>
    <view wx:if="{{!editingName}}" class="name-row" bindtap="startEditName">
      <text class="student-name">{{studentName}}</text>
      <text class="edit-hint">点击修改名字 ✎</text>
    </view>
    <view wx:else class="name-edit-row">
      <input class="name-input" value="{{tempName}}" bindinput="onNameInput" focus="{{editingName}}" maxlength="10" />
      <view class="name-save-btn" bindtap="saveName"><text class="name-save-text">保存</text></view>
      <view class="name-cancel-btn" bindtap="cancelEditName"><text class="name-cancel-text">取消</text></view>
    </view>

    <!-- 今日统计 -->
    <view class="stats-row">
      <view class="stat-item">
        <text class="stat-num">{{totalTasks}}</text>
        <text class="stat-label">个任务</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{completedToday}}</text>
        <text class="stat-label">已完成</text>
      </view>
      <view class="stat-divider"></view>
      <view class="stat-item">
        <text class="stat-num">{{progress}}%</text>
        <text class="stat-label">今日进度</text>
      </view>
    </view>
  </view>

  <!-- Canvas（隐藏，用于生成PDF图片） -->
  <canvas
    id="pdfCanvas"
    type="2d"
    style="position: fixed; left: -9999px; top: -9999px; width: 375px; height: 800px;"
  ></canvas>

  <!-- ─── 功能菜单 ─── -->
  <view class="menu-section">
    <text class="menu-title">📤 导出</text>
    <view class="menu-card">
      <view class="menu-item" bindtap="exportToPDF">
        <view class="menu-icon-wrap" style="background: #EEF7FF;">
          <text class="menu-icon">📄</text>
        </view>
        <view class="menu-text">
          <text class="menu-name">导出今日任务清单</text>
          <text class="menu-desc">生成图片保存到相册，可分享给家长</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <text class="menu-title">⚙️ 任务管理</text>
    <view class="menu-card">
      <view class="menu-item" bindtap="resetDefaultTasks">
        <view class="menu-icon-wrap" style="background: #FFF4E5;">
          <text class="menu-icon">🔄</text>
        </view>
        <view class="menu-text">
          <text class="menu-name">恢复默认任务</text>
          <text class="menu-desc">语文、数学、英语、阅读、运动...</text>
        </view>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <text class="menu-title">ℹ️ 关于</text>
    <view class="menu-card">
      <view class="menu-item">
        <view class="menu-icon-wrap" style="background: #F0FFF4;">
          <text class="menu-icon">📚</text>
        </view>
        <view class="menu-text">
          <text class="menu-name">每日任务清单</text>
          <text class="menu-desc">专为小学生设计的任务管理工具</text>
        </view>
        <text class="version-text">v1.0</text>
      </view>
    </view>
  </view>

  <view class="menu-section">
    <view class="menu-card danger-card">
      <view class="menu-item" bindtap="clearAllData">
        <view class="menu-icon-wrap" style="background: #FFF0F0;">
          <text class="menu-icon">🗑</text>
        </view>
        <view class="menu-text">
          <text class="menu-name danger-text">清除所有数据</text>
          <text class="menu-desc">删除全部任务和历史记录</text>
        </view>
        <text class="menu-arrow danger-text">›</text>
      </view>
    </view>
  </view>

  <view style="height: 80rpx;"></view>
</view>
