/* pages/settings/settings.wxss */

/* ─── 顶部 ─── */
.header {
  background: linear-gradient(135deg, #3D9BD1 0%, #5EAD8B 100%);
  padding: calc(env(safe-area-inset-top) + 30rpx) 32rpx 50rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  overflow: hidden;
}

.header::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: -30rpx; right: -30rpx;
  height: 60rpx;
  background: #FFF8EC;
  border-radius: 50%;
}

.header::before {
  content: '';
  position: absolute;
  top: -80rpx; right: -80rpx;
  width: 320rpx; height: 320rpx;
  background: rgba(255,255,255,0.12);
  border-radius: 50%;
}

.avatar-wrap {
  width: 140rpx; height: 140rpx;
  background: rgba(255,255,255,0.35);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 20rpx;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.12);
}

.avatar-emoji { font-size: 72rpx; }

.name-row {
  display: flex; flex-direction: column; align-items: center; gap: 8rpx;
  margin-bottom: 28rpx;
}

.student-name { font-size: 40rpx; font-weight: 900; color: #fff; }
.edit-hint { font-size: 22rpx; color: #FFFFFF; }

.name-edit-row {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 28rpx;
}

.name-input {
  background: rgba(255,255,255,0.9);
  border-radius: 16rpx; padding: 14rpx 20rpx;
  font-size: 30rpx; color: #2D2D2D; min-width: 200rpx;
}

.name-save-btn {
  background: rgba(255,255,255,0.9); border-radius: 16rpx; padding: 14rpx 20rpx;
}
.name-save-text { font-size: 26rpx; color: #5CC97A; font-weight: 800; }

.name-cancel-btn {
  background: rgba(255,255,255,0.3); border-radius: 16rpx; padding: 14rpx 20rpx;
}
.name-cancel-text { font-size: 26rpx; color: #fff; }

/* ─── 统计 ─── */
.stats-row {
  display: flex; align-items: center; justify-content: space-evenly;
  background: rgba(255,255,255,0.9);
  border-radius: 24rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.10);
  position: relative; z-index: 1;
  white-space: nowrap;
}

.stat-item {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  padding: 0 20rpx; flex-shrink: 0;
}

.stat-num { font-size: 40rpx; font-weight: 900; color: #2EA7D8; white-space: nowrap; }
.stat-label { font-size: 22rpx; color: #5A5A5A; white-space: nowrap; }

.stat-divider { width: 2rpx; height: 60rpx; background: #EEEEEE; flex-shrink: 0; }

/* ─── 菜单 ─── */
.menu-section {
  padding: 0 24rpx;
  margin-top: 28rpx;
}

.menu-title {
  display: block; font-size: 24rpx; color: #5A5A5A;
  font-weight: 700; margin-bottom: 12rpx;
  padding-left: 4rpx;
}

.menu-card {
  background: #FFFFFF; border-radius: 24rpx;
  overflow: hidden; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}

.menu-item {
  display: flex; align-items: center; padding: 24rpx 24rpx;
  gap: 20rpx; border-bottom: 2rpx solid #F5F5F5;
  transition: background 0.2s;
}

.menu-item:last-child { border-bottom: none; }
.menu-item-hover { background: #F0F0F0; }

.menu-icon-wrap {
  width: 80rpx; height: 80rpx; border-radius: 20rpx;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}

.menu-icon { font-size: 40rpx; }

.menu-text { flex: 1; min-width: 0; }

.menu-name { display: block; font-size: 28rpx; font-weight: 700; color: #2D2D2D; margin-bottom: 4rpx; }
.menu-desc { font-size: 22rpx; color: #5A5A5A; }

.menu-arrow { font-size: 40rpx; color: #767676; }

/* ─── 吸底分享按钮 ─── */
.share-bottom-wrap {
  position: fixed; bottom: 0; left: 0; right: 0;
  padding: 16rpx 32rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: rgba(255, 248, 236, 0.95);
  backdrop-filter: blur(8px);
}
.share-bottom-btn {
  background: linear-gradient(135deg, #3D9BD1, #5EAD8B);
  color: #fff; font-size: 30rpx; font-weight: 700;
  border: none; border-radius: 24rpx;
  padding: 24rpx 0; text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(61, 155, 209, 0.35);
}
.share-bottom-btn::after { display: none; }

.version-text { font-size: 24rpx; color: #767676; }
