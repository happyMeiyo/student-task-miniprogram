/* pages/export-pdf/export-pdf.wxss */

.container { background: #FFF8EC; min-height: 100vh; }

/* 导航栏 */
.nav-bar {
  display: flex; align-items: center; justify-content: space-between;
  padding: calc(env(safe-area-inset-top) + 10rpx) 24rpx 20rpx;
  background: linear-gradient(135deg, #3D9BD1, #5EAD8B);
}
.nav-back {
  width: 72rpx; height: 72rpx; background: rgba(255,255,255,0.25);
  border-radius: 50%; display: flex; align-items: center; justify-content: center;
}
.nav-back-icon { font-size: 48rpx; color: #fff; font-weight: 300; }
.nav-title { font-size: 32rpx; font-weight: 800; color: #fff; }

.content { padding: 24rpx; display: flex; flex-direction: column; gap: 20rpx; }

/* 预览卡片 */
.preview-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.07);
}
.preview-header { display: flex; align-items: center; gap: 20rpx; margin-bottom: 24rpx; }
.preview-icon-text { font-size: 64rpx; }
.preview-info { flex: 1; }
.preview-name { display: block; font-size: 30rpx; font-weight: 800; color: #2D2D2D; margin-bottom: 6rpx; }
.preview-date { font-size: 24rpx; color: #5A5A5A; }

.preview-stats { display: flex; align-items: center; margin-bottom: 20rpx; }
.stat-item { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6rpx; }
.stat-num { font-size: 44rpx; font-weight: 900; }
.stat-num.blue { color: #2EA7D8; }
.stat-num.green { color: #5CC97A; }
.stat-num.purple { color: #B57BEE; }
.stat-label { font-size: 22rpx; color: #5A5A5A; }
.stat-divider { width: 2rpx; height: 60rpx; background: #F0F0F0; }

.progress-bar-bg { height: 16rpx; background: #F0F0F0; border-radius: 8rpx; overflow: hidden; }
.progress-bar-fill {
  height: 100%; background: linear-gradient(90deg, #3D9BD1, #5CC97A);
  border-radius: 8rpx; transition: width 0.5s ease;
}

/* 任务选择卡片 */
.select-card {
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.select-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 20rpx;
}
.select-title { font-size: 28rpx; font-weight: 800; color: #2D2D2D; }
.select-all-btn {
  padding: 8rpx 20rpx; border-radius: 20rpx;
  background: #F0F8FF; border: 2rpx solid #3D9BD1;
}
.select-all-text { font-size: 24rpx; color: #2EA7D8; font-weight: 600; }

.select-list { display: flex; flex-direction: column; gap: 12rpx; }
.select-item {
  display: flex; align-items: center; gap: 16rpx;
  padding: 20rpx 16rpx; border-radius: 16rpx;
  background: #FAFAFA; transition: background 0.2s;
}
.select-item.selected { background: #F0F8FF; }

.select-checkbox {
  width: 44rpx; height: 44rpx; border-radius: 12rpx;
  border: 3rpx solid #3D9BD1; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  transition: background 0.2s;
}
.select-check-icon { font-size: 26rpx; color: #fff; font-weight: 900; }

.select-item-info { flex: 1; }
.select-item-name {
  display: block; font-size: 26rpx; font-weight: 700;
  color: #2D2D2D; margin-bottom: 4rpx;
}
.select-item-detail { font-size: 22rpx; color: #5A5A5A; }

.select-footer { margin-top: 16rpx; text-align: center; }
.select-summary { font-size: 24rpx; color: #555555; }

/* 状态卡片 */
.status-card {
  background: #fff; border-radius: 24rpx; padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
  display: flex; flex-direction: column; align-items: center; gap: 16rpx;
}
.status-icon-text { font-size: 60rpx; }
.status-icon-text.red { color: #FF7F7F; }
.status-text { font-size: 28rpx; color: #333333; text-align: center; }

/* Loading 环 */
.loading-ring {
  width: 60rpx; height: 60rpx;
  border: 6rpx solid #E0E0E0;
  border-top-color: #3D9BD1;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin { to { transform: rotate(360deg); } }

.gen-progress-bg { width: 100%; height: 12rpx; background: #F0F0F0; border-radius: 6rpx; overflow: hidden; }
.gen-progress-fill { height: 100%; background: linear-gradient(90deg, #3D9BD1, #5CC97A); border-radius: 6rpx; transition: width 0.4s; }

/* 按钮 */
.btn-group { display: flex; flex-direction: column; gap: 16rpx; }
.btn-export {
  background: linear-gradient(135deg, #3D9BD1, #5BB8E8);
  border-radius: 24rpx; padding: 32rpx;
  text-align: center; box-shadow: 0 8rpx 28rpx rgba(110,198,245,0.4);
}
.btn-export.btn-retry { background: linear-gradient(135deg, #B57BEE, #A06AE0); }
.btn-export-text { font-size: 30rpx; font-weight: 800; color: #fff; }

.btn-share {
  background: #fff; border-radius: 24rpx; padding: 28rpx;
  text-align: center; border: 3rpx solid #3D9BD1;
}
.btn-share-text { font-size: 28rpx; font-weight: 700; color: #2EA7D8; }

/* 提示 */
.tip-card {
  background: #EEF7FF; border-radius: 16rpx; padding: 20rpx 24rpx;
  display: flex; align-items: flex-start; gap: 12rpx;
}
.tip-icon { font-size: 28rpx; }
.tip-text { font-size: 24rpx; color: #2EA7D8; line-height: 1.7; flex: 1; }
